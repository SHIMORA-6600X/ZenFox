{
    "policies": {
        "SearchEngines": {
            "Add": [
                {
                    "Name": "SearXNG",
                    "Description": "SearXNG is a metasearch engine. Users are neither tracked nor profiled.",
                    "URLTemplate": "https://priv.au/search?q={searchTerms}",
                    "Method": "GET",
                    "SuggestURLTemplate": "https://priv.au/autocompleter?q={searchTerms}"
                },
                {
                    "Name": "Brave Search",
                    "Description": "The smarter way to search.",
                    "URLTemplate": "https://search.brave.com/search?q={searchTerms}",
                    "Method": "GET",
                    "IconURL": "https://cdn.search.brave.com/serp/favicon.ico"
                }
            ],
            "Default": "SearXNG"
        },
        "ExtensionSettings": {
            "{73a6fe31-595d-460b-a920-fcc0f8843232}": {
                "installation_mode": "force_installed",
                "install_url": "https://addons.mozilla.org/firefox/downloads/latest/noscript/latest.xpi",
                "private_browsing": true
            },
            "uBlock0@raymondhill.net": {
                "installation_mode": "force_installed",
                "install_url": "https://addons.mozilla.org/firefox/downloads/latest/ublock-origin/latest.xpi",
                "private_browsing": true
            },
            "@contain-facebook": {
                "installation_mode": "force_installed",
                "install_url": "https://addons.mozilla.org/firefox/downloads/latest/facebook-container/latest.xpi"
            },
            "@testpilot-containers": {
                "installation_mode": "force_installed",
                "install_url": "https://addons.mozilla.org/firefox/downloads/latest/multi-account-containers/latest.xpi"
            }
        }
    }
}